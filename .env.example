PC_TOKEN=replace-with-a-long-random-token
PC_PORT=8787
PC_WORKERS=2
PC_THREADS=4
# 飞牛 NAS 可改为实际共享目录的绝对路径
PC_DATA_DIR=./data
PC_DOWNLOAD_DIR=./downloads
# To show the same absolute NAS path inside the app, set PC_DOWNLOAD_DIR and
# PC_OUTPUT to that same directory. The default container path is /downloads.
